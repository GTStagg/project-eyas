# =============================================================================
# Project Eyas — environment reference
# =============================================================================
# YOU DO NOT NEED TO COPY THIS FILE. start.sh auto-creates an empty .env on
# first run and generates AUTH_SESSION_SECRET into it. Falcon + Anthropic
# credentials, IR / Shadow-AI host group ids, and sanctioned-tool lists are
# all collected in-browser via /register + /config and stored encrypted in
# data/eyas.db.
#
# This file is shipped only as a reference for the handful of optional knobs
# that are not surfaced in the wizard — scheduler cadence, outbound webhook,
# daily-budget banner, perf-log instrumentation. Copy individual lines into
# your own .env if you want them.
#
# Note for self-hosted Docker deployments: docker compose still reads .env
# the traditional way, so for the Docker path you do hand-edit values here.
# The standalone macOS bundle path (the typical use case) does not.

# -----------------------------------------------------------------------------
# Auth (required — auto-generated by start.sh)
# -----------------------------------------------------------------------------
# Encrypts the iron-session cookie AND is the root key for AES-256-GCM column
# encryption of credentials in data/eyas.db. Generated with `openssl rand
# -hex 32`. Rotating this invalidates active sessions AND invalidates every
# encrypted credential in the DB — intentional, so a leaked .env on its own
# can't be used to decrypt an exfiltrated db file.
AUTH_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Power-user knobs (all optional)
# -----------------------------------------------------------------------------

# Cap on agent-loop iterations per chat turn. Default 50 — sized for
# patching-heavy demos (RTR batch + extras_rtr_check_patch_status polling
# can chew through iterations). Lower if you want a tighter runaway guard.
#CHAT_MAX_ITERATIONS=50

# Soft daily spend budget (USD). When set, /cost shows a banner with today's
# spend vs. this cap, color-coded green / amber (≥75%) / red (≥100%). Visual
# guardrail only — does not throttle or block requests.
#DAILY_COST_BUDGET_USD=5.00

# Outbound delivery hook. When set, agentic outputs (briefing, investigate,
# ngsiem) render a "Send to webhook" button that POSTs the report as JSON
# ({title, source, timestamp, markdown, text}) to this URL. Demo with
# https://webhook.site; in production point at a Slack/Teams/Discord
# incoming webhook (all accept the same shape).
#OUTBOUND_WEBHOOK_URL=

# Performance instrumentation. Set to "true" to append per-request timing to
# data/perf-log.jsonl and emit JSONL middleware lines to stdout. Off by
# default. Aggregate with: npm run perf-summary
#PERF_LOG=true

# Gate routine info-level logs (scheduler ticks, bootstrap timing) on this
# flag. Off by default. console.error is always loud.
#DEBUG_LOGS=true

# -----------------------------------------------------------------------------
# Scheduler — opt-in recurring agentic jobs delivered to OUTBOUND_WEBHOOK_URL
# -----------------------------------------------------------------------------
# When SCHEDULER_ENABLED=true the server arms in-process timers at startup.
# Each timer runs a registered "job" on a recurring schedule and POSTs its
# markdown output to OUTBOUND_WEBHOOK_URL (which MUST be set — the scheduler
# refuses to arm without it). No writes occur; jobs are read-only agentic
# runs.
#
# Jobs are configured via the SCHEDULES manifest. Grammar:
#   SCHEDULES=<entry>[,<entry>…]
#   <entry> = <jobId>[:<dayspec>[@HH:MM]]
#   <dayspec> = DAILY | <day>[-<day>] | <day>[,<day>…]
#   <day> = SUN|MON|TUE|WED|THU|FRI|SAT
# Day/time are optional; each job ships sensible defaults.
#
# Registered job ids:
#   patch-digest    — picks the top open ExPRT-High+ has-fix bundle from
#                     Spotlight and posts the patch-plan decision document.
#                     Default cadence: MON@09:00.
#   daily-briefing  — runs the /api/briefing agent loop and posts the
#                     markdown. Default cadence: MON-FRI@09:00.
#   release-watcher — checks for upstream falcon-mcp + FalconPy releases
#                     and posts a summary when new versions land.
#
#SCHEDULER_ENABLED=false
#SCHEDULER_TZ=America/Denver
#SCHEDULES=
# Bearer secret for the manual-fire / status endpoints
# (GET|POST /api/scheduled/<jobId>). Generate with: openssl rand -hex 32
#SCHEDULER_TOKEN=

# -----------------------------------------------------------------------------
# Docker-compose path only — ignored by the standalone bundle
# -----------------------------------------------------------------------------
# These mirror what /register collects in the standalone path. Set them here
# only if you are running the Docker compose deployment and want to avoid
# the wizard. The standalone bundle ignores them.
#ANTHROPIC_API_KEY=
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_BASE_URL=
#ANTHROPIC_MODEL=claude-sonnet-5-5
#FALCON_CLIENT_ID=
#FALCON_CLIENT_SECRET=
#FALCON_BASE_URL=https://api.crowdstrike.com
#FALCON_MEMBER_CID=

# falcon-mcp transport (Docker path only — standalone always spawns stdio).
#FALCON_MCP_URL=http://falcon-mcp:8000/mcp
#FALCON_MCP_API_KEY=
#FALCON_MCP_MODULES=detections,cases,hosts
#FALCON_MCP_DEBUG=false

# First-run /register is only served to localhost / 127.0.0.1. To register
# through another host name (e.g. behind a reverse proxy), list it here,
# comma-separated.
#EYAS_ALLOWED_HOSTS=eyas.example.com

# Login throttling keys on the client address only when this is true. Set it
# only behind a reverse proxy you control that sets X-Forwarded-For.
#EYAS_TRUST_PROXY=false

# Override the falcon-extras Python interpreter (rarely needed).
#FALCON_EXTRAS_PYTHON=
