# dependencies
node_modules
.pnp
.pnp.js

# next.js
.next
out
next-env.d.ts

# typescript
*.tsbuildinfo

# production
dist
build

# env (never commit)
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# runtime data (cost log, etc.)
data

# misc
.DS_Store
*.pem
.vscode
.idea
.claude/*
!.claude/skills/
# Defense-in-depth: even inside the un-ignored skills tree, never track
# anything that smells like a secret. Skills ship as .md + .sh / .py only.
.claude/skills/**/.env*
.claude/skills/**/*.local.*
.claude/skills/**/*secret*
.claude/skills/**/*token*
.claude/skills/**/*credential*
.claude/skills/**/*.key
.claude/skills/**/*.pem

# playwright
playwright-report
test-results
tests/screenshots
tests/.auth

__pycache__/

# standalone distribution bundle (produced by ./make-dist.sh)
project-eyas-v*.zip
falcon-mcp-frontend-v*.zip

# private build overlay (package mirrors, gateway URL) sourced by make-dist.sh
internal/
