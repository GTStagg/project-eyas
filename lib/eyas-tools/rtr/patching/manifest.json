{
  "version": 1,
  "scripts": [
    {
      "id": "win-wsl-update",
      "title": "Update WSL kernel + runtime",
      "os": "windows",
      "script": "scripts/windows/wsl-update.ps1",
      "preambles": ["scripts/windows/_lib/require-admin.ps1"],
      "params": {},
      "expected_runtime_minutes": 4,
      "reboot_risk": "low",
      "spotlight_match": {
        "vendor_pattern": "^Microsoft( Corporation)?$",
        "product_pattern": "^(Windows Subsystem for Linux|WSL)"
      },
      "notes": "Runs `wsl --update --web-download`. Declared before win-update-install so its more-specific product pattern wins resolution; otherwise win-update-install's `^Windows` pattern would shadow it. No-ops on hosts without WSL installed; --web-download bypasses the Microsoft Store path, which is disabled or unreachable in many enterprise images."
    },
    {
      "id": "win-update-install",
      "title": "Install pending Windows Updates",
      "os": "windows",
      "script": "scripts/windows/windows-update-install.ps1",
      "preambles": ["scripts/windows/_lib/require-admin.ps1"],
      "params": {
        "kb_filter": {
          "type": "string",
          "optional": true,
          "pattern": "^KB[0-9]{6,7}(,KB[0-9]{6,7})*$",
          "description": "Comma-separated KB ids to install. Omit to install all pending."
        },
        "reboot": {
          "type": "enum",
          "values": ["never", "if-required", "force"],
          "default": "never",
          "description": "Post-install reboot policy."
        }
      },
      "expected_runtime_minutes": 25,
      "reboot_risk": "high",
      "spotlight_match": {
        "vendor_pattern": "^Microsoft( Corporation)?$",
        "product_pattern": "^(Windows|Microsoft Windows)"
      }
    },
    {
      "id": "win-reboot",
      "title": "Reboot Windows host",
      "os": "windows",
      "script": "scripts/windows/reboot.ps1",
      "preambles": ["scripts/windows/_lib/require-admin.ps1"],
      "params": {},
      "expected_runtime_minutes": 2,
      "reboot_risk": "high",
      "notes": "One-liner `Restart-Computer -Force`. Not auto-routed by Spotlight -- the agent invokes this explicitly when an operator asks to reboot a host (e.g. to finalize a 3010 patch return, DISM Disable-Feature, or .NET Framework install). Approval-gated through the standard extras_rtr_run_patch dry-run-first flow."
    },
