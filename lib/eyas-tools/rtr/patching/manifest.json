    {
      "id": "win-app-install",
      "title": "Install/upgrade a Windows app from a vendor URL",
      "os": "windows",
      "script": "scripts/windows/win-app-install.ps1",
      "preambles": [
        "scripts/windows/_lib/require-admin.ps1",
        "scripts/windows/_lib/msi-installer.ps1"
      ],
      "params": {
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9._~%:/?#\\[\\]@!&*+=-]{11,2048}$",
          "description": "Vendor HTTPS download URL."
        },
        "kind": {
          "type": "enum",
          "values": ["msi", "exe"],
          "default": "msi",
          "description": "Installer type: msi (msiexec /qn) or exe (silent switches via silent_args)."
        },
        "product": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 ._+\\-]{1,64}$",
          "description": "Friendly name shown in logs."
        },
        "sha256": {
          "type": "string",
          "optional": true,
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "Optional integrity pin; verified host-side, aborts on mismatch."
        },
        "silent_args": {
          "type": "string",
          "optional": true,
          "default": "",
          "pattern": "^[A-Za-z0-9 _\\-./:=\\\\,]{0,256}$",
          "description": "exe-only silent switches (ignored for kind=msi)."
        }
      },
      "expected_runtime_minutes": 8,
      "reboot_risk": "medium",
      "notes": "Generic runtime-extensible engine. Declared last with no spotlight_match so it never shadows a specific app script -- explicit-invoke only, reachable via extras_rtr_resolve_patch_plan(script_id=\"win-app-install\") and saved patch profiles. The MSI branch keeps fixed safe flags (/i /qn /norestart REBOOT=ReallySuppress) and ignores silent_args; silent_args applies to kind=exe only. Strongly prefer pinning sha256 -- an absent pin installs on HTTPS trust + operator approval alone and prints an UNVERIFIED banner."
    },
