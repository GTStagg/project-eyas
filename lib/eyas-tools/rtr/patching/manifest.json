    {
      "id": "win-dotnet-framework-update",
      "title": "Install pending .NET Framework updates (Microsoft Update)",
      "os": "windows",
      "script": "scripts/windows/dotnet-framework-update.ps1",
      "preambles": ["scripts/windows/_lib/require-admin.ps1"],
      "params": {
        "reboot": {
          "type": "enum",
          "values": ["never", "if-required", "force"],
          "default": "never",
          "description": "Post-install reboot policy."
        }
      },
      "expected_runtime_minutes": 15,
      "reboot_risk": "medium",
      "spotlight_match": {
        "vendor_pattern": "^Microsoft( Corporation)?$",
        "product_pattern": "^(Microsoft )?\\.Net Framework"
      },
      "notes": "Closes the gap left by win-update-install on hosts that haven't opted into Microsoft Update -- by default WUA only sees Windows OS updates. This script registers the Microsoft Update service (idempotent) and then drives WUA filtered to the .NET Framework category, so .NET-Framework Spotlight findings clear without enabling other-product updates fleet-wide."
