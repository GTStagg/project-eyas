    {
      "id": "app-jre-uninstall",
      "title": "Uninstall legacy Oracle JRE 6 / 7 / 8",
      "os": "windows",
      "script": "scripts/windows/jre-uninstall.ps1",
      "preambles": ["scripts/windows/_lib/require-admin.ps1"],
      "params": {},
