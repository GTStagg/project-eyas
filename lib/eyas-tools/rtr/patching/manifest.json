    {
      "id": "linux-pkg-upgrade",
      "title": "Upgrade a single Linux package (apt / dnf / yum)",
      "os": "linux",
      "script": "scripts/linux/pkg-upgrade-generic.sh",
      "preambles": [
        "scripts/linux/_lib/require-root.sh",
        "scripts/linux/_lib/pkg-helpers.sh"
      ],
      "params": {
        "package": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+\\-]{0,49}$",
          "description": "Package name (Debian or RPM). Strict regex — no shell metacharacters can survive validation."
        }
      },
      "expected_runtime_minutes": 4,
      "reboot_risk": "low",
      "notes": "Generic fallback for any Linux Spotlight remediation that doesn't have a dedicated curated script. Detects the host's package manager at runtime (apt → dnf → yum) and dispatches accordingly, so the same entry covers Debian / Ubuntu / RHEL / Rocky / Alma / Fedora / Amazon Linux. Routed to by the resolver when match_remediation finds no specific Linux script and the remediation product string yields a valid package name. Single-package only — multi-package bundles like Apache still need a dedicated script."
    },
