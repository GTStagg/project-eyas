      "reboot_risk": "low",
      "spotlight_match": {
        "vendor_pattern": "^Oracle( Corporation)?$",
        "product_pattern": "^(Oracle )?(JRE|Java Runtime)"
      },
      "notes": "Oracle JRE 6/7/8 are EOL with no public update path. This script removes them outright via msiexec /x. OpenJDK / Adoptium / Temurin / Azul Zulu / modern Oracle JDK 11+ are intentionally left alone."
