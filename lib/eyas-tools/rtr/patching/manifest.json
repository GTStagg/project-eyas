    {
      "id": "app-flash-uninstall",
      "title": "Uninstall Adobe Flash Player (NPAPI / ActiveX / PPAPI)",
      "os": "windows",
      "script": "scripts/windows/flash-uninstall.ps1",
      "preambles": ["scripts/windows/_lib/require-admin.ps1"],
      "params": {},
      "expected_runtime_minutes": 4,
      "reboot_risk": "low",
      "spotlight_match": {
        "vendor_pattern": "^Adobe( Systems( Incorporated)?)?$",
        "product_pattern": "^(Adobe )?Flash Player"
      },
      "notes": "Adobe Flash Player is EOL since 2020-12-31 and has no update path. Walks the uninstall registry hives (both 64-bit and WoW6432Node), removes every Flash Player install via msiexec /x for MSI entries or the registered FlashUtil uninstaller for non-MSI ones, and scrubs leftover %WINDIR%\\System32\\Macromed\\Flash and SysWOW64 equivalents so Spotlight stops reporting the product as present."
